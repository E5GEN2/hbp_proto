DATABASE_URL="postgresql://USER@localhost:5432/hbp_proto?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Everything below is optional for local dev. Placeholders only — never commit
# real values. The README "Environment variables" table explains each one.

# Base URL for links that leave the app (emails, payment callbacks); falls back
# to NEXTAUTH_URL. Keep commented out unless set — an empty value is not unset.
# APP_URL=

# Brand name in the UI, emails and invoices (build time). Empty = the default.
NEXT_PUBLIC_BRAND_NAME=""

# Email via Resend. Empty = emails are skipped (logged only); password reset is
# unavailable and sign-ups skip email verification.
RESEND_API_KEY=""
# Sender address. Keep commented out unless set — an empty value is not unset.
# EMAIL_FROM=

# Crypto payments via NOWPayments. Empty key = crypto checkout unavailable
# (or mocked, see ALLOW_MOCK_PAYMENTS).
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
# "true" = NOWPayments sandbox API (testing only).
NOWPAYMENTS_SANDBOX=""

# Telegram admin alerts. Empty token = every Telegram send is a no-op.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# Optional shared secret for an external trigger of /api/cron/sweep
# (x-cron-secret header). The sweep also runs in-process.
CRON_SECRET=""

# Local testing only: "true" enables the mock card / mock crypto payments.
# Always off when NODE_ENV=production.
ALLOW_MOCK_PAYMENTS=""

# Seed scripts (prisma/seed.ts, prisma/seed-clients.ts): at least 8 characters,
# otherwise a random password is generated and printed once.
SEED_ADMIN_PASSWORD=""
SEED_CLIENT_PASSWORD=""
